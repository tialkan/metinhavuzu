# Coolify ortam değişkenleri (gerçek değerler yalnız Coolify'da "secret" olarak)
# İkisi de verilirse site HTTP Basic Auth ile korunur. Telif izni kamusal gösterimi kapsayana kadar zorunlu.
PAROLA_KULLANICI=
PAROLA=

# Cloudflare atlanarak doğrudan sunucuya gelen istekleri reddetmek için (yalnız harf/rakam, en az 24 karakter).
# Aynı değer Cloudflare Transform Rule ile X-Metinhavuzu-Anahtar başlığına yazılır.
KAYNAK_ANAHTARI=
